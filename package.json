{
  "name": "@nexlytech/strict-lint",
  "version": "0.1.0",
  "description": "Folder-structure, one-component-per-file and native-element linting for React. One rule core, runs on both ESLint and oxlint.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "oxlint",
    "oxlint-plugin",
    "react",
    "architecture",
    "folder-structure",
    "shadcn"
  ],
  "license": "MIT",
  "author": "NexlyTech",
  "homepage": "https://github.com/NexlyTech/strict-lint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexlyTech/strict-lint.git"
  },
  "bugs": {
    "url": "https://github.com/NexlyTech/strict-lint/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "strict-lint": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "!dist/cli.cjs",
    "!dist/cli.d.cts",
    "!dist/cli.d.mts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && node scripts/cjs-interop.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "eslint": ">=8.57.0",
    "oxlint": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22.10.2",
    "@typescript-eslint/parser": "^8.70.1",
    "tsdown": "^0.23.0",
    "typescript": "^5.7.2"
  }
}
